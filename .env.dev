# Development Environment Configuration
# Use this template for local development with minimal security requirements

# Instance Configuration
INSTANCE_NAME=wordpress_dev
RESTART_POLICY=unless-stopped

# MySQL Configuration
MYSQL_VERSION=8.0
MYSQL_ROOT_PASSWORD=devroot123
MYSQL_DATABASE=wordpress_dev
MYSQL_USER=wordpress_dev
MYSQL_PASSWORD=devpass123

# WordPress Configuration
WP_VERSION=latest
WP_DEBUG=true
WP_DEBUG_LOG=true
WORDPRESS_TABLE_PREFIX=wp_

# Domain Configuration
DOMAIN_NAME=wordpress.local
LETSENCRYPT_EMAIL=dev@wordpress.local

# PHPMyAdmin Configuration
PHPMYADMIN_VERSION=latest
PHPMYADMIN_PORT=8080
