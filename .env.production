# Production Environment Configuration
# Use this template for production deployment with maximum security

# Instance Configuration
INSTANCE_NAME=wordpress_production
RESTART_POLICY=always

# MySQL Configuration - CHANGE THESE VALUES!
MYSQL_VERSION=8.0
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD_HERE_MIN_32_CHARS
MYSQL_DATABASE=wordpress_prod_db
MYSQL_USER=wordpress_prod_user
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD_HERE_MIN_32_CHARS

# WordPress Configuration
WP_VERSION=latest
WP_DEBUG=false
WP_DEBUG_LOG=false
WORDPRESS_TABLE_PREFIX=wp_

# Domain Configuration
DOMAIN_NAME=yourdomain.com
LETSENCRYPT_EMAIL=admin@yourdomain.com

# PHPMyAdmin Configuration
PHPMYADMIN_VERSION=latest
PHPMYADMIN_PORT=8080

# Security Settings (Advanced)
# Uncomment and configure for additional security

# Maximum file upload size (in bytes, for nginx)
# FILE_UPLOAD_MAX_SIZE=100M

# Memory limits
# WORDPRESS_MEMORY_LIMIT=256M

# Database connection timeout
# WORDPRESS_DB_TIMEOUT=20

# WordPress security constants (can be added to wp-config.php)
# WORDPRESS_AUTH_KEY=change_me
# WORDPRESS_SECURE_AUTH_KEY=change_me
# WORDPRESS_LOGGED_IN_KEY=change_me
# WORDPRESS_NONCE_KEY=change_me
