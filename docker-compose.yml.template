version: "3.9"

services:
  # MySQL Database Service
  db_{{INSTANCE_NAME}}:
    image: mysql:8.0
    container_name: wp-db-{{INSTANCE_NAME}}
    restart: always
    environment:
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD}
      MYSQL_DATABASE: ${MYSQL_DATABASE}
      MYSQL_USER: ${MYSQL_USER}
      MYSQL_PASSWORD: ${MYSQL_PASSWORD}
    volumes:
      - mysql_data_{{INSTANCE_NAME}}:/var/lib/mysql
    networks:
      - wordpress_network_{{INSTANCE_NAME}}
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost"]
      timeout: 20s
      retries: 10

  # WordPress Service
  wordpress_{{INSTANCE_NAME}}:
    image: wordpress:php{{PHP_VERSION}}-apache
    container_name: wp-app-{{INSTANCE_NAME}}
    restart: always
    depends_on:
      db_{{INSTANCE_NAME}}:
        condition: service_healthy
    ports:
      - "${WP_PORT}:80"
    environment:
      WORDPRESS_DB_HOST: db_{{INSTANCE_NAME}}:3306
      WORDPRESS_DB_NAME: ${MYSQL_DATABASE}
      WORDPRESS_DB_USER: ${MYSQL_USER}
      WORDPRESS_DB_PASSWORD: ${MYSQL_PASSWORD}
      WORDPRESS_TABLE_PREFIX: ${WP_TABLE_PREFIX}
      WORDPRESS_CONFIG_EXTRA: |
        define('WP_MEMORY_LIMIT', '1024M');
        define('WP_MAX_MEMORY_LIMIT', '2048M');
        @ini_set('upload_max_filesize', '5120M');
        @ini_set('post_max_size', '5120M');
        @ini_set('max_execution_time', '3600');
        @ini_set('max_input_time', '3600');
    volumes:
      - ./wp-content:/var/www/html/wp-content
      - ./uploads.ini:/usr/local/etc/php/conf.d/uploads.ini
      - ./apache-limits.conf:/etc/apache2/conf-enabled/limits.conf
    networks:
      - wordpress_network_{{INSTANCE_NAME}}
    labels:
      - "com.wordpress.instance={{INSTANCE_NAME}}"

  # phpMyAdmin Service
  phpmyadmin_{{INSTANCE_NAME}}:
    image: phpmyadmin/phpmyadmin:latest
    container_name: wp-pma-{{INSTANCE_NAME}}
    restart: always
    depends_on:
      - db_{{INSTANCE_NAME}}
    ports:
      - "${PMA_PORT}:80"
    environment:
      PMA_HOST: db_{{INSTANCE_NAME}}
      PMA_USER: ${MYSQL_USER}
      PMA_PASSWORD: ${MYSQL_PASSWORD}
      PMA_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD}
      UPLOAD_LIMIT: 5120M
      MEMORY_LIMIT: 1024M
    networks:
      - wordpress_network_{{INSTANCE_NAME}}
    labels:
      - "com.wordpress.instance={{INSTANCE_NAME}}"

networks:
  wordpress_network_{{INSTANCE_NAME}}:
    driver: bridge

volumes:
  mysql_data_{{INSTANCE_NAME}}:
    driver: local
