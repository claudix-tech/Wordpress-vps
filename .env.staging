# Staging Environment Configuration
# Use this template for pre-production testing with enhanced security

# Instance Configuration
INSTANCE_NAME=wordpress_staging
RESTART_POLICY=always

# MySQL Configuration
MYSQL_VERSION=8.0
MYSQL_ROOT_PASSWORD=staging_root_$(openssl rand -hex 8)
MYSQL_DATABASE=wordpress_staging
MYSQL_USER=wordpress_staging
MYSQL_PASSWORD=staging_db_$(openssl rand -hex 12)

# WordPress Configuration
WP_VERSION=latest
WP_DEBUG=true
WP_DEBUG_LOG=true
WORDPRESS_TABLE_PREFIX=wp_

# Domain Configuration
DOMAIN_NAME=staging.yourdomain.com
LETSENCRYPT_EMAIL=admin@staging.yourdomain.com

# PHPMyAdmin Configuration
PHPMYADMIN_VERSION=latest
PHPMYADMIN_PORT=8080
